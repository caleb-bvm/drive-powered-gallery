# Settings for the Docker deployment. Copy to .env in this folder (never commit it).

# Public address, with https
SITE_URL=https://example.com

# 48 random characters. Generate with:  openssl rand -base64 36
# Never change it after launch: every access code and session depends on it.
APP_SECRET=

# Password for the bundled Postgres. Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Studio sign-in with Google (docs/google-setup.md, part 3)
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Studio password. Works next to Google sign-in (handy on localhost, where the
# Google redirect URI may not match). Leave empty to allow Google only.
# Generate one with:  openssl rand -base64 18
ADMIN_PASSWORD=

# Google Drive (docs/google-setup.md, parts 1 and 2)
DRIVE_MODE=google
# Your photo library folder (e.g. "Photo Repository"); the Studio browses everything under it
DRIVE_ROOT_FOLDER_ID=
# The key itself goes in deploy/secrets/drive-key.json, not here.
