# ---------------------------------------------------------------------------
# Michael's Gallery: environment
# Copy to .env.local for development. Everything is optional in development:
# without values the app runs on an embedded database and a mock Drive.
# ---------------------------------------------------------------------------

# Public URL of the site (used in delivery emails and OAuth redirects)
SITE_URL=http://localhost:3000

# Long random string (32+ chars). Signs sessions and preview links, and hashes
# and encrypts access codes. Changing it invalidates every code and session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Postgres connection string (Supabase, Neon...). Empty = embedded PGlite in .data/
DATABASE_URL=

# --- Studio sign-in -------------------------------------------------------
# Comma-separated Google accounts allowed into /studio
ADMIN_EMAILS=calebortiz288@gmail.com
# Google OAuth client (Google Cloud console > APIs & Services > Credentials,
# type "Web application", redirect URI: {SITE_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Studio password. Works next to Google sign-in (handy on localhost, where the
# Google redirect URI may not match). Leave empty to allow Google only.
# Generate one with:  openssl rand -base64 18
ADMIN_PASSWORD=

# --- Google Drive ---------------------------------------------------------
# "mock" reads folders from MOCK_DRIVE_DIR (run `npm run seed` to create it).
# "google" uses the Drive API with a service account.
DRIVE_MODE=mock
MOCK_DRIVE_DIR=.data/mock-drive
# ID of your photo library folder (e.g. "Photo Repository"), shared with the
# service account as Viewer. The Studio browses everything under it.
DRIVE_ROOT_FOLDER_ID=
# The service account's JSON key: a path to the file (preferred, used by Docker),
# or the JSON itself pasted on one line (or base64 of it)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Preview storage ------------------------------------------------------
# "local" writes previews to LOCAL_STORAGE_DIR (development / single server).
STORAGE_MODE=local
LOCAL_STORAGE_DIR=.data/storage
